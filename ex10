
# EXPERIMENT 10: HIERARCHICAL AND DBSCAN CLUSTERING

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy.cluster.hierarchy import linkage, dendrogram
from sklearn.cluster import AgglomerativeClustering, DBSCAN, KMeans
from sklearn.datasets import make_blobs, make_moons

# PART A: HIERARCHICAL CLUSTERING

# 1. Enter data points
X = np.array([
    (5, 19), (4, 17), (11, 25), (6, 22), (12, 21),
    (10, 21), (14, 24), (3, 16), (10, 24), (4, 21)
])

pd.DataFrame(X, columns=["x", "y"]).to_csv(
    "points.csv", index=False
)

print("Data Points:")
print(X)

# 2. Plot raw data points
plt.figure(figsize=(7, 4.5))
plt.scatter(X[:, 0], X[:, 1], s=80)
plt.xlabel("X")
plt.ylabel("Y")
plt.title("Original Data Points")
plt.grid(True)
plt.show()

# 3. Build the merge table
Z = linkage(X, method="average")

print("\nMerge Table:")
print("Merged        Distance    Size")
for a, b, distance, size in Z:
    print("%3d and %-3d %7.2f %d" %
          (a, b, distance, size))

# 4. Draw dendrogram
plt.figure(figsize=(8, 4.5))
dendrogram(Z)
plt.title("Dendrogram (Average Linkage)")
plt.xlabel("Point Number")
plt.ylabel("Distance")
plt.show()

# 5. Form two clusters
model = AgglomerativeClustering(
    n_clusters=2, linkage="average"
)
labels = model.fit_predict(X)

print("\nCluster Labels:", labels)

for c in [0, 1]:
    print("Cluster", c, ":",
          [tuple(int(v) for v in p) for p in X[labels == c]])

# 6. Plot hierarchical clusters
plt.figure(figsize=(7, 4.5))
plt.scatter(X[:, 0], X[:, 1],
            c=labels, cmap="rainbow", s=90)

for i, p in enumerate(X):
    plt.annotate(str(i), (p[0] + 0.15, p[1] + 0.15))

plt.xlabel("X")
plt.ylabel("Y")
plt.title("Agglomerative Clustering (2 Clusters)")
plt.grid(True)
plt.show()


# PART B: DBSCAN CLUSTERING

# 7. Generate sample data
B, _ = make_blobs(
    n_samples=750,
    n_features=2,
    centers=3,
    cluster_std=0.4,
    random_state=0
)

print("\nDBSCAN Data Shape:", B.shape)
print("First three points:")
print(B[:3].round(2))

# 8. Run DBSCAN
dbscan = DBSCAN(eps=0.5, min_samples=4).fit(B)
lab = dbscan.labels_

n_clusters = len(set(lab)) - (1 if -1 in lab else 0)

print("\nClusters Found:", n_clusters)
print("Noise Points:", int((lab == -1).sum()))
print("Cluster Sizes:", np.bincount(lab[lab >= 0]))
print("Core Points:", len(dbscan.core_sample_indices_))

# 9. Plot DBSCAN clusters
plt.figure(figsize=(7, 4.5))

plt.scatter(
    B[lab >= 0, 0], B[lab >= 0, 1],
    c=lab[lab >= 0], cmap="viridis", s=15
)

plt.scatter(
    B[lab == -1, 0], B[lab == -1, 1],
    c="black", marker="x", s=60, label="Noise"
)

plt.xlabel("X Axis")
plt.ylabel("Y Axis")
plt.title("DBSCAN (eps=0.5, min_samples=4)")
plt.legend()
plt.show()

# 10. Study the effect of eps
print("\nEffect of Different Epsilon Values:")

for e in [0.1, 0.2, 0.3, 0.5, 1.0]:
    l = DBSCAN(eps=e, min_samples=4).fit(B).labels_
    k = len(set(l)) - (1 if -1 in l else 0)
    noise = int((l == -1).sum())

    print("eps =", e, "clusters =", k, "noise =", noise)

# 11. Compare K-Means and DBSCAN
M, _ = make_moons(
    n_samples=300, noise=0.06, random_state=0
)

km = KMeans(
    n_clusters=2, random_state=0, n_init=10
).fit_predict(M)

db = DBSCAN(
    eps=0.2, min_samples=4
).fit_predict(M)

print("\nDBSCAN clusters on moon data:",
      len(set(db)) - (1 if -1 in db else 0))
print("DBSCAN noise points:", int((db == -1).sum()))

# Plot comparison
fig, ax = plt.subplots(1, 2, figsize=(11, 4.2))

ax[0].scatter(M[:, 0], M[:, 1], c=km, cmap="coolwarm", s=15)
ax[0].set_title("K-Means (K=2)")

ax[1].scatter(M[:, 0], M[:, 1], c=db, cmap="coolwarm", s=15)
ax[1].set_title("DBSCAN (eps=0.2)")

plt.show()

print("\nExperiment 10 completed successfully.")
